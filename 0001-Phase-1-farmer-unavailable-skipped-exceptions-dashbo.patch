@@ -0,0 +1,54 @@
+-- PHASE 1 §5 — Exception Basics
+-- Structured statuses for: farmer unavailable, farmer skipped, route issue, other.
+-- Mirrors the route_deviations RLS shape already in use (agent owns their rows,
+-- manager/owner see everything in their mcc).
+
+create table public.trip_exceptions (
+  id uuid primary key default gen_random_uuid(),
+  trip_id uuid not null references public.route_trips(id),
+  agent_id uuid not null references public.agents(id),
+  mcc_id uuid not null references public.mcc_centres(id),
+  route_point_id uuid references public.route_points(id),
+  farmer_id uuid references public.farmers(id),
+  type text not null check (type in ('farmer_unavailable', 'farmer_skipped', 'route_issue', 'other')),
+  reason text,
+  status text not null default 'open' check (status in ('open', 'resolved')),
+  created_by uuid references auth.users(id),
+  created_at timestamptz not null default now(),
